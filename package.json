{
  "name": "clock-note-widget",
  "version": "0.5.0",
  "description": "时钟 + 便签 桌面小组件（两个独立窗口）",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/make-icon.js",
    "dist": "electron-builder --win"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.local.clock-note-widget",
    "productName": "ClockNoteWidget",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "clock.html",
      "note.html",
      "assets/tray.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true
    }
  }
}
